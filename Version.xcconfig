// Single source for the human-facing version and monotonically increasing
// build number. Release automation validates both values before packaging.
MARKETING_VERSION = 2.0.0
CURRENT_PROJECT_VERSION = 13

// The publisher supplies DEVELOPMENT_TEAM at build time. Never replace this
// with a guessed team identifier.
LidPilotTeamIdentifier = $(DEVELOPMENT_TEAM)

// Developer builds intentionally leave the updater unconfigured. Release
// builds must supply both values through the release environment.
SUFeedURL =
SUPublicEDKey =

MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
